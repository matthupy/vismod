# vismod docker-compose secrets — copy to .env (gitignored) and fill ONLY if you
# switch adapter.name off the credential-free "stub".
#
#   cp .env.example .env
#
# Secrets reach the binary as VISMOD_-prefixed env vars and are NEVER written into
# config.yaml or docker-compose.yml. Leave blank to run the stub adapter.

# --- Azure AI Content Safety (set VISMOD_ADAPTER_NAME=azure) ---
VISMOD_AZURE_KEY=
VISMOD_AZURE_ENDPOINT=
VISMOD_AZURE_TOKEN=  # only for auth_mode: bearer (default apikey uses VISMOD_AZURE_KEY)

# --- Hive (set VISMOD_ADAPTER_NAME=hive) ---
VISMOD_HIVE_TOKEN=
